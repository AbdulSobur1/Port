{
  "name": "abdullah-abdulsobur-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "world:validate": "node scripts/validate-world.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm world:validate",
    "geo:download": "node scripts/download-osm.mjs",
    "geo:tools": "node scripts/download-sources.mjs",
    "geo:tiles": "node scripts/build-tiles.mjs",
    "geo:water": "node scripts/extract-water-from-tiles.mjs",
    "geo:world": "node scripts/extract-world-data.mjs",
    "geo:all": "npm run geo:download && npm run geo:tools && npm run geo:tiles && npm run geo:water && npm run geo:world",
    "geo:place": "node scripts/place-streets.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "next": "16.4.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.183.0",
    "osm-pbf-parser": "^2.3.0",
    "typescript": "5.9.3"
  }
