# Copy this file to `.env.local` and adjust as needed. All variables are optional;
# the app runs with sensible defaults when they are unset.

# Canonical site origin, used for metadata, canonical URLs, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://soburr-three.vercel.app

# Real-world geographic ground (MapLibre GL JS).
# `off` disables the real map and keeps the fully procedural ground beneath the city.
NEXT_PUBLIC_WORLD_MAP=on

# A MapLibre style URL (vector or raster). When unset, a keyless OpenStreetMap
# raster style is used. Set this to your own MapTiler/Mapbox/Stadia style to brand
# the map or lift tile rate limits.
# NEXT_PUBLIC_MAP_STYLE_URL=

# The real WGS84 point ("lat,lng") that world coordinate (0, 0) projects onto.
# Defaults to central Abuja, Nigeria: 9.05785, 7.49508
# NEXT_PUBLIC_WORLD_ORIGIN=
